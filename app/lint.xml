<?xml version="1.0" encoding="UTF-8"?>
<lint>
    <!-- strings.xml is the source of truth for both apps: the iOS catalog and its
         L10n accessors are generated from it. So a string can be live on iOS and
         genuinely unreferenced here, and lint is right about the reference while
         being wrong about the string being dead. Scoped to the copy that is
         genuinely iOS-only today, rather than blanket-disabled: the Pro strings,
         which Android will use when its paywall lands, and the store-unreadable
         screen, which Android never reaches because Room refuses to open at all. -->
    <issue id="UnusedResources">
        <ignore regexp="R\.string\.pro_" />
        <ignore regexp="R\.string\.store_unreadable_" />
    </issue>
</lint>
